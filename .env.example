# Example environment variables for local development.
# Do not put real secrets, real tokens, real database passwords, or production URLs here.

NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:3000

# Example only. Replace with your own local DB URL in .env.
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME

# Example only. Generate a real value in .env.
SESSION_SECRET=replace_me_with_random_session_secret

# Shopify Storefront API settings.
# Put real values only in .env, not in this file.
SHOPIFY_STOREFRONT_URL=https://your-shop-name.myshopify.com/api/2025-01/graphql.json
SHOPIFY_STOREFRONT_TOKEN=replace_me_with_shopify_storefront_token

# Shopify webhook verification secret.
SHOPIFY_WEBHOOK_SECRET=replace_me_with_shopify_webhook_secret

# Webhook rate limit per minute.
WEBHOOK_RPM=60
